# Copy to .env and fill in your own values.
# Loaded by docker-compose and by the Makefile (`-include .env`).
# .env is gitignored — never commit real values.

# Server IP to bind ports to (0.0.0.0 = all interfaces).
# Also the default for AIO_BIND in `make build-aio`.
BIND_IP=0.0.0.0

# Cloudflare API token for wildcard TLS cert (DNS-01 challenge).
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Permissions needed: Zone > DNS > Edit, on the zone you tunnel under.
# Used by Caddy in the Docker deployment, and embedded by `make build-aio`.
CF_API_TOKEN=your-cloudflare-api-token-here

# ── AIO builds only (`make build-aio`) ──────────────────────────────
# See docs/development.md for the full variable list.

# ACME account email for Let's Encrypt. Required for AIO builds.
# MABO_TUNNEL_AIO_EMAIL works too — the Makefile accepts either.
AIO_EMAIL=admin@example.com

# Base domain to issue certs for (this domain and *.this domain).
AIO_DOMAIN=tunnel.example.com

# ── `make run-server` / `make run-client` ───────────────────────────
# These targets carry no hostname of their own, so set yours here.
# The binaries' own compiled-in defaults are local-only.

# Base domain the server serves tunnels under.
MABO_TUNNEL_DOMAIN=tunnel.example.com

# Server WebSocket URL the client dials.
MABO_TUNNEL_SERVER=wss://tunnel.example.com

# A token from `mabo-tunnel-token generate <username> <plan>`.
MABO_TUNNEL_TOKEN=REPLACE_WITH_A_GENERATED_TOKEN
